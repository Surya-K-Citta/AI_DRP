
# Personal data in the database is encrypted with AES-256-GCM using this key (required in production).
# Use 64 hex characters (openssl rand -hex 32). Keep a copy somewhere safe: without it the data cannot be read.
DATA_ENCRYPTION_KEY=
# When rotating, put the old key(s) here (comma separated) until `encryptExisting` has re-run.
DATA_ENCRYPTION_KEY_PREVIOUS=

# Optional: share rate limits and the account-status cache between API servers.
REDIS_URL=
# MongoDB connection pool (per API server).
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
# Serve Swagger UI and openapi.json in production (always on in development).
ENABLE_API_DOCS=false
