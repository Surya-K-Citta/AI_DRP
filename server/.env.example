
# Personal data in the database is encrypted with AES-256-GCM using this key (required in production).
# Use 64 hex characters (openssl rand -hex 32). Keep a copy somewhere safe: without it the data cannot be read.
DATA_ENCRYPTION_KEY=
# When rotating, put the old key(s) here (comma separated) until `encryptExisting` has re-run.
DATA_ENCRYPTION_KEY_PREVIOUS=

# Optional: share rate limits and the account-status cache between API servers.
REDIS_URL=
# MongoDB connection pool (per API server).
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
# Serve Swagger UI and openapi.json in production (always on in development).
ENABLE_API_DOCS=false

# Voice input (speech to text). With a Sarvam key, spoken answers are transcribed by Sarvam first (Telugu and Indian English),
# then OpenAI Whisper / the Telugu Whisper model as fallbacks. Leave empty to use only those. Audio is sent as spoken.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4

# Open-source speech server for Telugu (and English fallback): any server with the OpenAI /v1/audio/transcriptions API,
# e.g. speaches (faster-whisper). See docs/voice-input.md. Leave empty to skip.
STT_SERVICE_URL=
STT_SERVICE_KEY=
STT_MODEL_TE=vasista22/whisper-telugu-small
STT_MODEL_EN=Systran/faster-whisper-small.en

# Longest one sign-in can last, in hours, however active the person is (default 8).
SESSION_MAX_HOURS=8
