{
  "name": "msme-dpr-server",
  "version": "1.0.0",
  "description": "Backend for MSME AI DPR Generation Tool",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "node --experimental-strip-types --import ./register-tests.mjs --test src/production.backend.test.ts src/security.test.ts src/financeGuard.parity.test.ts src/aiGateway.test.ts src/platform.test.ts src/openapi.test.ts",
    "test:rbac": "node --experimental-strip-types --test --test-concurrency=1 src/rbac.live.test.ts",
    "test:session": "node --experimental-strip-types --test --test-concurrency=1 src/session.live.test.ts",
    "test:security": "node --experimental-strip-types --test --test-concurrency=1 src/security.live.test.ts",
    "test:finance": "node --experimental-strip-types --test --test-concurrency=1 src/finance.live.test.ts",
    "test:admin": "node --experimental-strip-types --import ./register-tests.mjs --test --test-concurrency=1 src/admin.live.test.ts",
    "test:api": "node --experimental-strip-types --test --test-concurrency=1 src/api.live.test.ts",
    "test:pdf": "node --experimental-strip-types --import ./register-tests.mjs --test --test-concurrency=1 src/pdf.smoke.test.ts",
    "test:encryption": "node --experimental-strip-types --import ./register-tests.mjs --test --test-concurrency=1 src/encryption.live.test.ts",
    "encrypt:existing": "ts-node --transpile-only src/scripts/encryptExisting.ts",
    "test:support": "node --experimental-strip-types --test --test-concurrency=1 src/support.live.test.ts",
    "docs:openapi": "node scripts/generateOpenApi.mjs"
  },
  "keywords": [
    "msme",
    "dpr",
    "ai",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.13.0",
    "pdfmake": "^0.2.20",
    "puppeteer": "^24.36.0",
    "sanitize-html": "^2.17.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.12.12",
    "@types/sanitize-html": "^2.16.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "ioredis-mock": "^8.13.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
