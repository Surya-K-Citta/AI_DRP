{
  "name": "msme-dpr-client",
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend for MSME AI DPR Generation Tool",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --experimental-strip-types --test src/lib/dprFixes.test.ts src/lib/finance/finance.test.ts src/lib/production.ui.test.ts src/lib/reportGuide.test.ts src/lib/aiDisclaimer.test.ts src/lib/documentStyleOptions.test.ts src/lib/voice/spokenValue.test.ts src/lib/sessionClock.test.ts src/lib/i18n/userTextTe.test.ts",
    "test:screens": "playwright test",
    "vectors": "node --experimental-strip-types scripts/finance-vectors.mjs",
    "lock:formulas": "node --experimental-strip-types scripts/lock-formulas.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs --strict",
    "audit:responsive": "node scripts/responsive-audit.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "axios": "^1.6.2",
    "clsx": "^2.1.1",
    "docx": "^8.5.0",
    "dompurify": "^3.3.1",
    "i18next": "^23.7.6",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^13.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.6.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.10.2",
    "eslint": "^8.54.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vite": "^5.0.7"
  }
